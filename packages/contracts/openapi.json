    "/api/v1/games": {
      "get": {
        "summary": "Games",
        "operationId": "games_api_v1_games_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 200,
              "default": "",
              "title": "Q"
