  "components": {
    "schemas": {
      "Credentials": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "minLength": 3,
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 10,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "Credentials"
      },
      "Evidence": {
        "properties": {
          "label": {
            "type": "string",
            "title": "Label"
          },
          "url": {
            "type": "string",
            "title": "Url"
          },
          "field": {
            "type": "string",
            "title": "Field"
          },
          "observed_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Observed At"
          }
        },
        "type": "object",
        "required": [
          "label",
          "url",
          "field"
        ],
        "title": "Evidence"
      },
      "FeedbackInput": {
        "properties": {
          "game_id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Game Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "like",
              "dislike",
              "owned",
              "exclude"
            ],
            "title": "Kind"
          }
        },
        "type": "object",
        "required": [
          "game_id",
          "kind"
        ],
        "title": "FeedbackInput"
      },
      "Game": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "steam_app_id": {
            "type": "integer",
            "title": "Steam App Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "title_zh": {
            "type": "string",
            "title": "Title Zh"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "themes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Themes"
          },
          "genres": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Genres"
          },
          "platforms": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Platforms"
          },
          "chinese_support": {
            "type": "string",
            "enum": [
              "verified",
              "unknown",
              "unsupported"
            ],
            "title": "Chinese Support"
          },
          "coop": {
            "type": "string",
            "enum": [
              "online",
              "local",
              "none",
              "unknown"
            ],
            "title": "Coop"
          },
          "horror": {
            "type": "string",
            "enum": [
              "yes",
              "no",
              "unknown"
            ],
            "title": "Horror"
          },
          "image_url": {
            "type": "string",
            "title": "Image Url"
          },
          "store_url": {
            "type": "string",
            "title": "Store Url"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/Evidence"
            },
            "type": "array",
            "title": "Evidence"
          },
          "metadata_status": {
            "type": "string",
            "enum": [
              "curated",
              "provider"
            ],
            "title": "Metadata Status"
          },
          "estimated_hours": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Estimated Hours"
          }
        },
        "type": "object",
        "required": [
          "id",
          "steam_app_id",
          "title",
          "title_zh",
          "description",
          "themes",
          "genres",
          "platforms",
          "chinese_support",
          "coop",
          "horror",
          "image_url",
          "store_url",
          "evidence",
          "metadata_status"
        ],
        "title": "Game"
      },
      "GameList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Game"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total"
        ],
        "title": "GameList"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Offer": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "store": {
            "type": "string",
            "title": "Store"
          },
          "price_minor": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Price Minor"
          },
          "regular_price_minor": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Regular Price Minor"
          },
          "currency": {
            "type": "string",
            "const": "USD",
            "title": "Currency"
          },
          "url": {
            "type": "string",
            "title": "Url"
          },
          "country": {
            "type": "string",
            "title": "Country"
          },
          "fetched_at": {
            "type": "string",
            "title": "Fetched At"
          },
          "source_updated_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Updated At"
          },
          "edition": {
            "type": "string",
            "title": "Edition"
          },
          "activation_status": {
            "type": "string",
            "enum": [
              "unknown",
              "verified",
              "unsupported"
