            "title": "Activation Status"
          },
          "eligible_for_best": {
            "type": "boolean",
            "title": "Eligible For Best"
          },
          "provider": {
            "type": "string",
            "const": "cheapshark",
            "title": "Provider"
          }
        },
        "type": "object",
        "required": [
          "id",
          "store",
          "price_minor",
          "regular_price_minor",
          "currency",
          "url",
          "country",
          "fetched_at",
          "edition",
          "activation_status",
          "eligible_for_best",
          "provider"
