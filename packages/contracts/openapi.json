  "components": {
    "schemas": {
      "AlertInput": {
        "properties": {
          "enabled": {
            "type": "boolean",
            "title": "Enabled"
          },
          "expected_version": {
            "type": "integer",
            "maximum": 2000000000.0,
            "minimum": 0.0,
            "title": "Expected Version"
          },
          "consent_version": {
            "anyOf": [
              {
                "type": "string",
                "const": "observed-usd-inapp-v1"
              },
              {
                "type": "null"
              }
            ],
            "title": "Consent Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "enabled",
          "expected_version"
        ],
        "title": "AlertInput"
      },
      "AlertState": {
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "off",
              "armed",
              "pending",
              "notified",
              "failed"
            ],
            "title": "State"
          },
          "version": {
            "type": "integer",
            "title": "Version"
          },
          "consent_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Consent Version"
          },
          "mode": {
            "type": "string",
            "const": "own_query_observation",
            "title": "Mode",
            "default": "own_query_observation"
          },
          "automatic_price_polling": {
            "type": "boolean",
            "const": false,
            "title": "Automatic Price Polling",
            "default": false
          },
          "external_email": {
            "type": "boolean",
            "const": false,
            "title": "External Email",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "state",
          "version",
          "consent_version"
        ],
        "title": "AlertState"
      },
      "Credentials": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "minLength": 3,
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 10,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "Credentials"
      },
      "Evidence": {
        "properties": {
          "label": {
            "type": "string",
            "title": "Label"
          },
          "url": {
            "type": "string",
            "title": "Url"
          },
          "field": {
            "type": "string",
            "title": "Field"
          },
          "observed_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Observed At"
          }
        },
        "type": "object",
        "required": [
          "label",
          "url",
          "field"
        ],
        "title": "Evidence"
      },
      "FeedbackInput": {
        "properties": {
          "game_id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Game Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "like",
              "dislike",
