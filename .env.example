# Local Python server. Docker Compose supplies its PostgreSQL URL separately.
DATABASE_URL=sqlite:///./.state/playmatch.db
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=false
RUN_WORKERS=2
RUN_TIMEOUT_SECONDS=90

# Optional model provider: configure all three to enable real model calls.
# Use your provider's compatible chat/completions base URL, without a trailing endpoint.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Optional catalog provider. No credentials are required for the starter catalog.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Compose defaults are for local development. Use a URL-safe random password
# (letters, digits, '-' and '_'); the value is included in a database URL.
POSTGRES_PASSWORD=local-development-only
# If WEB_PORT changes, also update both origins in ALLOWED_ORIGINS above.
WEB_PORT=3000

# Retrieval is separate from LLM intent parsing; no embedding network calls by default.
RETRIEVAL_MODE=bm25
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_SECONDS=8
SEMANTIC_MIN_SCORE=0.65

# Required for indexed_hybrid: operator asserts an immutable provider model revision.
EMBEDDING_REVISION=

# Local quickstart uses embedded SQL consumers; Compose explicitly uses external workers.
RUN_EXECUTION_MODE=embedded
RUN_LEASE_SECONDS=15
RUN_MAX_ATTEMPTS=3
RUN_TIMEOUT_SECONDS=90
RUN_POLL_SECONDS=0.25

# Steam identity discovery only. No key is sent to browsers or placed in URLs.
# Enable only with an operator-owned key and opt in to the Compose catalog-sync profile.
STEAM_WEB_API_KEY=
STEAM_SYNC_ENABLED=false
STEAM_SYNC_INTERVAL_SECONDS=600
STEAM_FULL_SYNC_SECONDS=604800
STEAM_SYNC_PAGE_SIZE=5000
STEAM_SYNC_DAILY_REQUESTS=1000
