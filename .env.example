# Local Python server. Docker Compose supplies its PostgreSQL URL separately.
DATABASE_URL=sqlite:///./.state/playmatch.db
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=false
RUN_WORKERS=2
RUN_TIMEOUT_SECONDS=90

# Optional model provider: configure all three to enable real model calls.
# Use your provider's compatible chat/completions base URL, without a trailing endpoint.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Optional catalog provider. No credentials are required for the starter catalog.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Compose defaults are for local development. Use a URL-safe random password
# (letters, digits, '-' and '_'); the value is included in a database URL.
POSTGRES_PASSWORD=local-development-only
# If WEB_PORT changes, also update both origins in ALLOWED_ORIGINS above.
WEB_PORT=3000
