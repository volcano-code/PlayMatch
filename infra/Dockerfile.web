FROM node:24-slim AS dependencies
WORKDIR /app
COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci

FROM dependencies AS builder
COPY apps/web ./
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM node:24-slim AS runner
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0 \
    PORT=3000
RUN groupadd --gid 10001 playmatch \
    && useradd --uid 10001 --gid playmatch --create-home playmatch
COPY --from=builder --chown=playmatch:playmatch /app/.next/standalone ./
COPY --from=builder --chown=playmatch:playmatch /app/.next/static ./.next/static
COPY --from=builder --chown=playmatch:playmatch /app/public ./public
USER playmatch
EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=5s --start-period=15s --retries=5 \
    CMD node -e "fetch('http://127.0.0.1:3000/').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node", "server.js"]
